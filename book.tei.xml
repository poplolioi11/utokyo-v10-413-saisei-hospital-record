"1489" xml:id="zone-line-04R-c02"/><zone ulx="1942" uly="420" lrx="2008" lry="1489" xml:id="zone-line-04R-c03"/><zone ulx="1871" uly="420" lrx="1937" lry="1489" xml:id="zone-line-04R-c04"/><zone ulx="1800" uly="420" lrx="1866" lry="1489" xml:id="zone-line-04R-c05"/><zone ulx="1731" uly="420" lrx="1797" lry="1489" xml:id="zone-line-04R-c06"/><zone ulx="1661" uly="420" lrx="1727" lry="1489" xml:id="zone-line-04R-c07"/><zone ulx="1591" uly="420" lrx="1657" lry="1489" xml:id="zone-line-04R-c08"/><zone ulx="1520" uly="420" lrx="1586" lry="1489" xml:id="zone-line-04R-c09"/><zone ulx="1454" uly="420" lrx="1520" lry="1489" xml:id="zone-line-04R-c10"/></surface><surface n="face-04L" xml:id="surface-face-04L"><graphic url="https://iiif.dl.itc.u-tokyo.ac.jp/iiif/soto_gakken/V10_413/V10_413_0004.tif/full/2400,/0/default.jpg"/><zone ulx="1121" uly="405" lrx="1187" lry="1490" xml:id="zone-line-04L-c01"/><zone ulx="1052" uly="405" lrx="1118" lry="1490" xml:id="zone-line-04L-c02"/><zone ulx="980" uly="405" lrx="1046" lry="1490" xml:id="zone-line-04L-c03"/><zone ulx="908" uly="405" lrx="974" lry="1490" xml:id="zone-line-04L-c04"/><zone ulx="834" uly="405" lrx="900" lry="1490" xml:id="zone-line-04L-c05"/><zone ulx="765" uly="405" lrx="831" lry="1490" xml:id="zone-line-04L-c06"/><zone ulx="695" uly="405" lrx="761" lry="1490" xml:id="zone-line-04L-c07"/><zone ulx="626" uly="405" lrx="692" lry="1490" xml:id="zone-line-04L-c08"/><zone ulx="554" uly="405" lrx="620" lry="1490" xml:id="zone-line-04L-c09"/><zone ulx="484" uly="405" lrx="550" lry="1490" xml:id="zone-line-04L-c10"/></surface><surface n="face-05R-c01-04" xml:id="surface-face-05R-c01-04"><graphic url="https://iiif.dl.itc.u-tokyo.ac.jp/iiif/soto_gakken/V10_413/V10_413_0005.tif/full/2400,/0/default.jpg"/><zone ulx="2097" uly="418" lrx="2163" lry="1473" xml:id="zone-line-05R-c01"/><zone ulx="2026" uly="418" lrx="2092" lry="1473" xml:id="zone-line-05R-c02"/><zone ulx="1956" uly="418" lrx="2022" lry="1473" xml:id="zone-line-05R-c03"/><zone ulx="1889" uly="421" lrx="1955" lry="503" xml:id="zone-line-05R-c04"/></surface></facsimile><text><body><div type="account" xml:id="account"><ab><pb n="face-03L" facs="#surface-face-03L"/><lb n="1" xml:id="line-03L-c01" facs="#zone-line-03L-c01"/>濟生醫院記<lb n="2" xml:id="line-03L-c02" facs="#zone-line-03L-c02"/>濟生医院在于下總國海上郡荒野村栗園<lb n="3" xml:id="line-03L-c03" facs="#zone-line-03L-c03"/>淺田宗伯先生之所設而門人林君靜斎之<lb n="4" xml:id="line-03L-c04" facs="#zone-line-03L-c04"/>所幹也院之名濟生蓋非偶然也抑人處世<lb n="5" xml:id="line-03L-c05" facs="#zone-line-03L-c05"/>所以其為最幸者何也健康是而已今夫学<lb n="6" xml:id="line-03L-c06" facs="#zone-line-03L-c06"/>通古今才識内外經歴天下交契豪傑詳明<lb n="7" xml:id="line-03L-c07" facs="#zone-line-03L-c07"/>治亂矯正流俗者而身有疾病豈得展其學<lb n="8" xml:id="line-03L-c08" facs="#zone-line-03L-c08"/>与才哉今夫智度天地勇<unclear cert="low">盍</unclear>海山席卷宇内<lb n="9" xml:id="line-03L-c09" facs="#zone-line-03L-c09"/>籠絡群雄攻伐必勝<unclear cert="low">盡</unclear>策必成而身有疾病<lb n="10" xml:id="line-03L-c10" facs="#zone-line-03L-c10"/>豈得<unclear cert="low">運</unclear>其智与勇哉今夫陶朱之富懸肉為<pb n="face-04R" facs="#surface-face-04R"/><lb n="1" xml:id="line-04R-c01" facs="#zone-line-04R-c01"/>林酌酒為池絲竹奏音<unclear cert="low">解花献眉</unclear>而四体羸弱豈<lb n="2" xml:id="line-04R-c02" facs="#zone-line-04R-c02"/>足慰其心哉今夫文武之基威徳赫烈湛澤浹洽<lb n="3" xml:id="line-04R-c03" facs="#zone-line-04R-c03"/>政令雲行教化雨布而四体羸弱豈足樂其意<lb n="4" xml:id="line-04R-c04" facs="#zone-line-04R-c04"/>哉故苟人而無不希壽康而憂羸弱也而使<lb n="5" xml:id="line-04R-c05" facs="#zone-line-04R-c05"/>得欲保有此二者而保人生之最幸非濟生者<lb n="6" xml:id="line-04R-c06" facs="#zone-line-04R-c06"/>而何乎是所以有此院也明治維新制度一變<lb n="7" xml:id="line-04R-c07" facs="#zone-line-04R-c07"/>百般之事皆取法於歐米諸州而刀圭之術亦尤<lb n="8" xml:id="line-04R-c08" facs="#zone-line-04R-c08"/>尚西説如其器用之利解剖之能則以為前古<lb n="9" xml:id="line-04R-c09" facs="#zone-line-04R-c09"/>未曽有而目國醫以迂遠醫道之衰替極矣蓋<lb n="10" xml:id="line-04R-c10" facs="#zone-line-04R-c10"/>古者丹波雅忠割皮解肌結筋<unclear cert="low">擣髓</unclear>華陀破腹<pb n="face-04L" facs="#surface-face-04L"/><lb n="1" xml:id="line-04L-c01" facs="#zone-line-04L-c01"/>取病復為縫之此皆西人所謂窮極精能者而古<lb n="2" xml:id="line-04L-c02" facs="#zone-line-04L-c02"/>之医於數千年前固既為之國医未必不若西医<lb n="3" xml:id="line-04L-c03" facs="#zone-line-04L-c03"/>也栗園先生当今之大医於舉世溺没之時堅<lb n="4" xml:id="line-04L-c04" facs="#zone-line-04L-c04"/>守故説百折不變欲興斯道之衰替屈子所謂<lb n="5" xml:id="line-04L-c05" facs="#zone-line-04L-c05"/>世皆濁我独清衆皆醉我獨醒者而林君亦勉<lb n="6" xml:id="line-04L-c06" facs="#zone-line-04L-c06"/>強從事能体先生之意豈非有所見而不為異<lb n="7" xml:id="line-04L-c07" facs="#zone-line-04L-c07"/>説所動揺何能如此耶然則國醫之術復毅然振<lb n="8" xml:id="line-04L-c08" facs="#zone-line-04L-c08"/>起而此院之隆盛可期而待矣况於其濟生者乎<lb n="9" xml:id="line-04L-c09" facs="#zone-line-04L-c09"/>今茲七月土木竣功以三日挙開院之典我師歐波<lb n="10" xml:id="line-04L-c10" facs="#zone-line-04L-c10"/>先生与栗園先生有故而又知林君矣令子胤<pb n="face-05R-c01-04" facs="#surface-face-05R-c01-04"/><lb n="1" xml:id="line-05R-c01" facs="#zone-line-05R-c01"/>寬君松陰為祝詞使予<unclear cert="low">綴</unclear>筆焉予淺學菲才<lb n="2" xml:id="line-05R-c02" facs="#zone-line-05R-c02"/>何足與之然誼不可辭因書平生之持論以為<lb n="3" xml:id="line-05R-c03" facs="#zone-line-05R-c03"/>記明治柔兆閹茂七月北總松<unclear cert="low">渚</unclear>漁史宮内<unclear cert="low">彬</unclear><unclear cert="low">謹</unclear><lb n="4" xml:id="line-05R-c04" facs="#zone-line-05R-c04"/>識</ab></div></body></text></TEI>