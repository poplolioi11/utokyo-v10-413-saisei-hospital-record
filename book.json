  "units": [
    {
      "id": "line-03L-c01",
      "page_id": "face-03L",
      "section": "account",
      "column": 1,
      "role": "title",
      "text": "濟生醫院記",
      "xywh": [
        1110,
        552,
        66,
        372
      ]
    },
    {
      "id": "line-03L-c02",
      "page_id": "face-03L",
      "section": "account",
      "column": 2,
      "role": "body",
      "text": "濟生医院在于下總國海上郡荒野村栗園",
      "xywh": [
        1038,
        410,
        66,
        1067
      ]
    },
    {
      "id": "line-03L-c03",
      "page_id": "face-03L",
      "section": "account",
      "column": 3,
      "role": "body",
      "text": "淺田宗伯先生之所設而門人林君靜斎之",
      "xywh": [
        962,
        410,
        66,
        1067
      ]
    },
    {
      "id": "line-03L-c04",
      "page_id": "face-03L",
      "section": "account",
      "column": 4,
      "role": "body",
      "text": "所幹也院之名濟生蓋非偶然也抑人處世",
      "xywh": [
        891,
        410,
        66,
        1067
      ]
    },
    {
      "id": "line-03L-c05",
      "page_id": "face-03L",
      "section": "account",
      "column": 5,
      "role": "body",
      "text": "所以其為最幸者何也健康是而已今夫学",
      "xywh": [
        821,
        410,
        66,
        1067
      ],
      "editorial_note": "欄底從三點與子形，屬日式慣用寫形。"
    },
    {
      "id": "line-03L-c06",
      "page_id": "face-03L",
      "section": "account",
      "column": 6,
      "role": "body",
      "text": "通古今才識内外經歴天下交契豪傑詳明",
      "xywh": [
        753,
        410,
        66,
        1067
      ]
    },
    {
      "id": "line-03L-c07",
      "page_id": "face-03L",
      "section": "account",
      "column": 7,
      "role": "body",
      "text": "治亂矯正流俗者而身有疾病豈得展其學",
      "xywh": [
        680,
        410,
        66,
        1067
      ]
    },
    {
      "id": "line-03L-c08",
      "page_id": "face-03L",
      "section": "account",
      "column": 8,
      "role": "body",
      "text": "与才哉今夫智度天地勇盍海山席卷宇内",
      "xywh": [
        611,
        410,
        66,
        1067
      ],
      "uncertainties": [
        {
          "start": 10,
          "end": 11,
          "reading": "盍",
          "alternatives": [
            "蓋"
          ],
          "basis": "圖上底部近皿，字頭形體不完整。"
        }
      ]
    },
    {
      "id": "line-03L-c09",
      "page_id": "face-03L",
      "section": "account",
      "column": 9,
      "role": "body",
      "text": "籠絡群雄攻伐必勝盡策必成而身有疾病",
      "xywh": [
        541,
        410,
        66,
        1067
      ],
      "uncertainties": [
        {
          "start": 8,
          "end": 9,
          "reading": "盡",
          "alternatives": [
            "畫"
          ],
          "basis": "圖面下形有橫線與分隔筆，兩讀待覆核。"
        }
      ]
    },
    {
      "id": "line-03L-c10",
      "page_id": "face-03L",
      "section": "account",
      "column": 10,
      "role": "body",
      "text": "豈得運其智与勇哉今夫陶朱之富懸肉為",
      "xywh": [
        466,
        410,
        66,
        1067
      ],
      "editorial_note": "高倍率欄影下，得後字內較近軍形，兩讀仍需覆核。",
      "uncertainties": [
        {
          "start": 2,
          "end": 3,
          "reading": "運",
          "alternatives": [
            "逞"
          ],
          "basis": "走之內書寫連筆，故保留另一讀。"
        }
      ]
    },
    {
      "id": "line-04R-c01",
      "page_id": "face-04R",
      "section": "account",
      "column": 1,
      "role": "body",
      "text": "林酌酒為池絲竹奏音解花献眉而四体羸弱豈",
      "xywh": [
        2086,
        420,
        66,
        1069
      ],
      "uncertainties": [
        {
          "start": 9,
          "end": 13,
          "reading": "解花献眉",
          "alternatives": [
            "解衣軒眉"
          ],
          "basis": "首讀保留花及献的慣用寫形，相關連筆仍難定。"
        }
      ]
    },
    {
      "id": "line-04R-c02",
      "page_id": "face-04R",
      "section": "account",
      "column": 2,
      "role": "body",
      "text": "足慰其心哉今夫文武之基威徳赫烈湛澤浹洽",
      "xywh": [
        2015,
        420,
        66,
        1069
      ]
    },
    {
      "id": "line-04R-c03",
      "page_id": "face-04R",
      "section": "account",
      "column": 3,
      "role": "body",
      "text": "政令雲行教化雨布而四体羸弱豈足樂其意",
      "xywh": [
        1942,
        420,
        66,
        1069
      ]
    },
    {
      "id": "line-04R-c04",
      "page_id": "face-04R",
      "section": "account",
      "column": 4,
      "role": "body",
      "text": "哉故苟人而無不希壽康而憂羸弱也而使",
      "xywh": [
        1871,
        420,
        66,
        1069
      ]
    },
    {
      "id": "line-04R-c05",
      "page_id": "face-04R",
      "section": "account",
      "column": 5,
      "role": "body",
      "text": "得欲保有此二者而保人生之最幸非濟生者",
      "xywh": [
        1800,
        420,
        66,
        1069
      ]
    },
    {
      "id": "line-04R-c06",
      "page_id": "face-04R",
      "section": "account",
      "column": 6,
      "role": "body",
      "text": "而何乎是所以有此院也明治維新制度一變",
      "xywh": [
        1731,
        420,
        66,
        1069
      ]
    },
    {
      "id": "line-04R-c07",
      "page_id": "face-04R",
      "section": "account",
      "column": 7,
      "role": "body",
      "text": "百般之事皆取法於歐米諸州而刀圭之術亦尤",
      "xywh": [
        1661,
        420,
        66,
        1069
      ],
      "editorial_note": "尤上另有一完整亦字。"
    },
    {
      "id": "line-04R-c08",
      "page_id": "face-04R",
      "section": "account",
      "column": 8,
      "role": "body",
      "text": "尚西説如其器用之利解剖之能則以為前古",
      "xywh": [
        1591,
        420,
        66,
        1069
      ]
    },
    {
      "id": "line-04R-c09",
      "page_id": "face-04R",
      "section": "account",
      "column": 9,
      "role": "body",
      "text": "未曽有而目國醫以迂遠醫道之衰替極矣蓋",
      "xywh": [
        1520,
        420,
        66,
        1069
      ]
    },
    {
      "id": "line-04R-c10",
      "page_id": "face-04R",
      "section": "account",
      "column": 10,
      "role": "body",
      "text": "古者丹波雅忠割皮解肌結筋擣髓華陀破腹",
      "xywh": [
        1454,
        420,
        66,
        1069
      ],
      "uncertainties": [
        {
          "start": 12,
          "end": 14,
          "reading": "擣髓",
          "alternatives": [
            "摘腫"
          ],
          "basis": "左手旁及後字右件可見，墨筆連字。"
        }
      ]
    },
    {
      "id": "line-04L-c01",
      "page_id": "face-04L",
      "section": "account",
      "column": 1,
      "role": "body",
      "text": "取病復為縫之此皆西人所謂窮極精能者而古",
      "xywh": [
        1121,
        405,
        66,
        1085
      ]
    },
    {
      "id": "line-04L-c02",
      "page_id": "face-04L",
      "section": "account",
      "column": 2,
      "role": "body",
      "text": "之医於數千年前固既為之國医未必不若西医",
      "xywh": [
        1052,
        405,
        66,
        1085
      ]
    },
    {
      "id": "line-04L-c03",
      "page_id": "face-04L",
      "section": "account",
      "column": 3,
      "role": "body",
      "text": "也栗園先生当今之大医於舉世溺没之時堅",
      "xywh": [
        980,
        405,
        66,
        1085
      ]
    },
    {
      "id": "line-04L-c04",
      "page_id": "face-04L",
      "section": "account",
      "column": 4,
      "role": "body",
      "text": "守故説百折不變欲興斯道之衰替屈子所謂",
      "xywh": [
        908,
        405,
        66,
        1085
      ]
    },
    {
      "id": "line-04L-c05",
      "page_id": "face-04L",
      "section": "account",
      "column": 5,
      "role": "body",
      "text": "世皆濁我独清衆皆醉我獨醒者而林君亦勉",
      "xywh": [
        834,
        405,
        66,
        1085
      ]
    },
    {
      "id": "line-04L-c06",
      "page_id": "face-04L",
      "section": "account",
      "column": 6,
      "role": "body",
      "text": "強從事能体先生之意豈非有所見而不為異",
      "xywh": [
        765,
        405,
        66,
        1085
      ]
    },
    {
      "id": "line-04L-c07",
      "page_id": "face-04L",
      "section": "account",
      "column": 7,
      "role": "body",
      "text": "説所動揺何能如此耶然則國醫之術復毅然振",
      "xywh": [
        695,
        405,
        66,
        1085
      ]
    },
    {
      "id": "line-04L-c08",
      "page_id": "face-04L",
      "section": "account",
      "column": 8,
      "role": "body",
      "text": "起而此院之隆盛可期而待矣况於其濟生者乎",
      "xywh": [
        626,
        405,
        66,
        1085
      ]
    },
    {
      "id": "line-04L-c09",
      "page_id": "face-04L",
      "section": "account",
      "column": 9,
      "role": "body",
      "text": "今茲七月土木竣功以三日挙開院之典我師歐波",
      "xywh": [
        554,
        405,
        66,
        1085
      ]
    },
    {
      "id": "line-04L-c10",
      "page_id": "face-04L",
      "section": "account",
      "column": 10,
      "role": "body",
      "text": "先生与栗園先生有故而又知林君矣令子胤",
      "xywh": [
        484,
        405,
        66,
        1085
      ],
      "editorial_note": "左側末欄看到令頂與下一個子形，原稿此處以令子相稱。"
    },
    {
      "id": "line-05R-c01",
      "page_id": "face-05R-c01-04",
      "section": "account",
      "column": 1,
      "role": "body",
      "text": "寬君松陰為祝詞使予綴筆焉予淺學菲才",
      "xywh": [
        2097,
        418,
        66,
        1055
      ],
      "uncertainties": [
        {
          "start": 9,
          "end": 10,
          "reading": "綴",
          "alternatives": [],
          "basis": "字左從糸旁形，右下可見連筆。"
        }
      ]
    },
    {
      "id": "line-05R-c02",
      "page_id": "face-05R-c01-04",
      "section": "account",
      "column": 2,
      "role": "body",
      "text": "何足與之然誼不可辭因書平生之持論以為",
      "xywh": [
        2026,
        418,
        66,
        1055
      ]
    },
    {
      "id": "line-05R-c03",
      "page_id": "face-05R-c01-04",
      "section": "account",
      "column": 3,
      "role": "closing-signature",
      "text": "記明治柔兆閹茂七月北總松渚漁史宮内彬謹",
      "xywh": [
        1956,
        418,
        66,
        1055
      ],
      "editorial_note": "館圖見水旁右件下近日形。依圖暫讀渚，保留浦候選。",
      "roles_in_column": [
